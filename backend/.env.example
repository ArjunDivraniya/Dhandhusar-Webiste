# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database (Prisma)
# Primary pooled connection for application queries (e.g. Supabase transaction pooler port 6543)
DATABASE_URL=postgresql://postgres:password@localhost:5432/dhandhusar_db?schema=public

# Optional direct session connection for Prisma migrations and schema introspection
DIRECT_URL=postgresql://postgres:password@localhost:5432/dhandhusar_db?schema=public

# Allowed Frontend Origins (CORS)
CORS_ORIGIN=http://localhost:5173

# JWT Authentication Secrets
# (Generate strong, unique secrets with `openssl rand -hex 32` for production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Initial Super Admin Provisioning (used by `npm run seed:admin`)
SUPER_ADMIN_EMAIL=admin@dhandusar.gujarat.gov.in
SUPER_ADMIN_PASSWORD=change_this_strong_password_123!
SUPER_ADMIN_NAME=Chief Administrator

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
