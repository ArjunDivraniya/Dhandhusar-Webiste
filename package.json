{
  "name": "explore-dhandhusar-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Explore Dhandusar — Premium bilingual digital village platform (Monorepo)",
  "workspaces": [
    "dhandhusar-frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=dhandhusar-frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

